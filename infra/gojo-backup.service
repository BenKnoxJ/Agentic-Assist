# Daily snapshot of the conversation database. Paired with gojo-backup.timer.
# Install: sudo cp infra/gojo-backup.{service,timer} /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now gojo-backup.timer
[Unit]
Description=Back up Gojo's checkpoint database

[Service]
Type=oneshot
User=ccuser
ExecStart=/usr/bin/python3 /home/ccuser/Agentic-Assist/infra/backup-checkpoints.py
